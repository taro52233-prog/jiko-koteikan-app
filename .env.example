# ---- 動作モード ----
# true の間は Threads へ実際に投稿しない（投稿済み扱いにするだけ）。本番前は必ず true で動作確認
DRY_RUN=true
# Webプロセス内で定期ジョブ（収集・下書き生成・投稿・計測）を動かすか
ENABLE_SCHEDULER=false

# ---- 承認画面のログイン（必須） ----
APP_USERNAME=admin
APP_PASSWORD=change-me

# ---- Threads API（Meta for Developers で発行） ----
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# 必要な権限: threads_basic, threads_content_publish, threads_keyword_search, threads_manage_insights

# ---- 楽天ウェブサービス ----
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=
# 楽天側のAPI仕様変更に備えてURLは差し替え可能
RAKUTEN_SEARCH_URL=https://app.rakuten.co.jp/services/api/IchibaItem/Search/20220601

# ---- Claude API ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- 運用パラメータ ----
# カンマ区切り。リサーチと商品検索の両方に使う
KEYWORDS=育児グッズ,食べこぼし,ベビーカー
DRAFTS_PER_KEYWORD=2
# 1日の投稿上限（スパム判定回避のため控えめに）
MAX_POSTS_PER_DAY=3
DATABASE_PATH=data/app.db
