# ===========================================================================
# auto-instagram 設定テンプレート
# ローカル検証時はこのファイルを .env にコピーして値を入れる。
# GitHub Actions では同名の Secrets / Variables を設定する。
# ===========================================================================

# --- 実行モード ------------------------------------------------------------
# review = 承認Issueを立て、ラベルが付いたものだけ投稿（推奨・既定）
# auto   = 生成したものを人の確認なしで投稿
POST_MODE=review
# 1日に投稿する上限（API上限は50。まずは1〜2から始める）
MAX_POSTS_PER_DAY=2

# --- 画像の公開先（Instagram は「公開URLの画像」しか受け付けない） -----------
# GitHub Pages をリポジトリのルートから配信する場合（既存の index.html も生きたまま）:
#   https://<GitHubユーザー名>.github.io/<リポジトリ名>/docs/ig
PUBLIC_BASE_URL=https://example.github.io/jiko-koteikan-app/docs/ig

# --- 商品リサーチ（楽天ウェブサービス） --------------------------------------
# https://webservice.rakuten.co.jp/ でアプリIDを無料発行
RAKUTEN_APP_ID=
# https://affiliate.rakuten.co.jp/ のアフィリエイトID（未設定だと通常リンクになる）
RAKUTEN_AFFILIATE_ID=
# 探索キーワード（カンマ区切り）。空ならランキングのみ
RESEARCH_KEYWORDS=タンブラー,加湿器,デスクライト,ワイヤレスイヤホン
# 楽天ジャンルID（カンマ区切り）。0 = 総合ランキング
RESEARCH_GENRE_IDS=0
RESEARCH_MIN_PRICE=1000
RESEARCH_MAX_PRICE=30000
RESEARCH_MIN_REVIEW_COUNT=20
RESEARCH_MIN_REVIEW_AVERAGE=4.0
RESEARCH_POOL_SIZE=60
# 同じショップを何日空けるか（似た投稿の連続を防ぐ）
RESEARCH_SHOP_COOLDOWN_DAYS=7

# --- コピー生成（Claude API） ----------------------------------------------
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
BRAND_PERSONA=20〜30代の生活者に向けて、誇張せず具体的に語る親しみやすい日本語
CONTENT_SLIDES=5
CONTENT_MAX_HASHTAGS=20
# 景品表示法（ステマ規制）対応。アフィリエイト運用では true のままにすること
CONTENT_DISCLOSURE_REQUIRED=true
CONTENT_DISCLOSURE_TEXT=【PR】この投稿にはアフィリエイトリンク・広告が含まれます。

# --- 画像 ------------------------------------------------------------------
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1350
IMAGE_ACCENT=#2563EB
IMAGE_ACCENT2=#0EA5E9
# 空なら Noto Sans CJK → IPAGothic の順に自動探索する
FONT_PATH_BOLD=
FONT_PATH_REGULAR=

# --- Instagram（Meta Graph API） -------------------------------------------
# 前提: プロアカウント（ビジネス/クリエイター）+ Facebookページ連携 + アプリ審査通過
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
IG_GRAPH_VERSION=v23.0
IG_GRAPH_HOST=graph.facebook.com
IG_CONTAINER_TIMEOUT_SEC=180
