# ── ① リスト収集：Google Places API (New) ──
# https://console.cloud.google.com/ で「Places API (New)」を有効化し、APIキーを発行
GOOGLE_PLACES_API_KEY=

# ── ④ 送信：Gmail ──
# 2段階認証を有効にした上で「アプリパスワード」を発行して使う（通常のログインPWは不可）
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── 送信者情報（特定電子メール法で表示が必須）──
SENDER_COMPANY=◯◯遺品整理サービス
SENDER_PERSON=山田 太郎
SENDER_ADDRESS=大阪府堺市◯◯区◯◯1-2-3
SENDER_TEL=072-000-0000
SENDER_WEBSITE=https://example.com
